// Aegis executable identity and original project artwork.
#include <winuser.h>
#include <winver.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/platform/win32/bb-probe.manifest"
@AEGIS_ICON_RESOURCE@

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Aegis - 13 Sentinels Runtime\0"
      VALUE "InternalName", "Aegis\0"
      VALUE "OriginalFilename", "Aegis.exe\0"
      VALUE "ProductName", "Aegis\0"
      VALUE "FileVersion", "1.0.0\0"
      VALUE "ProductVersion", "1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
